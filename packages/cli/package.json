{
  "name": "vayu-ui-cli",
  "keywords": [
    "vayu-ui",
    "react",
    "components",
    "hooks",
    "cli",
    "ui",
    "library"
  ],
  "description": "CLI for adding Vayu UI components and hooks to your React project",
  "version": "1.1.0",
  "author": "Rugved Patel",
  "bin": {
    "vayu-ui": "./bin/run.js"
  },
  "bugs": "https://github.com/Rugved1652/vayu-ui/issues",
  "dependencies": {
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.0",
    "vayu-ui-registry": "1.1.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^18",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^10",
    "oclif": "^4",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "tsup": "^8.5.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json",
    "./dist/templates"
  ],
  "homepage": "https://vayu.design/docs/cli-support",
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "vayu-ui",
    "dirname": "vayu-ui",
    "commands": "./dist/commands",
    "helpClass": "./dist/help.js",
    "additionalHelpFlags": [
      "-h"
    ],
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " "
  },
  "repository": "https://github.com/Rugved1652/vayu-ui/tree/main/packages/cli",
  "scripts": {
    "build": "tsup && node ../../scripts/package-cli.mjs",
    "check": "tsc --noEmit",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "prepack": "npm run build && oclif manifest",
    "test": "node --import tsx ../../node_modules/mocha/bin/mocha.js --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "types": "dist/index.d.ts"
}
